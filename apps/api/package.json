{
  "name": "@clara/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsup",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "test": "tsx --env-file-if-exists=../../.env --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@clara/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "fflate": "^0.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6"
  }
}
