# Desenvolvimento local apenas; use credenciais próprias em produção.
DATABASE_URL=postgresql://clara:clara_local@127.0.0.1:5432/clara
TEST_DATABASE_URL=postgresql://clara:clara_local@127.0.0.1:5432/clara_test
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Sem SMTP, mensagens são gravadas em .local/mail (somente desenvolvimento).
MAIL_MODE=local
MAIL_FROM=Clara <nao-responda@example.com>
